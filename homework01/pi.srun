#!/bin/bash
#SBATCH --account=cs399                 ### verified account for this local run
#SBATCH --partition=compute             ### queue to submit to
#SBATCH --job-name=compu_pi             ### job name
#SBATCH --output=output/comp_pi_%A.out  ### file in which to store job stdout
#SBATCH --error=output/comp_pi_%A.err   ### file in which to store job stderr
#SBATCH --time=00:15:00                 ### wall-clock time limit
#SBATCH --mem=4G                        ### host memory per node
#SBATCH --nodes=1                       ### number of nodes to use
#SBATCH --ntasks-per-node=1             ### number of MPI tasks per node
#SBATCH --cpus-per-task=32               ### one OpenMP process, up to 32 threads
#SBATCH --constraint=7713               ### homogeneous AMD Milan compute node

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:?Submit from the homework01 directory}"

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OMP_DYNAMIC=FALSE
export OMP_PLACES="cores"
export OMP_PROC_BIND='spread'
export OMP_DISPLAY_ENV=FALSE
export OMP_WAIT_POLICY=PASSIVE

# Compilation and correctness tests run on the allocated compute node.
hostname -f
make
python3 tests/test_pi.py --exe ./pi
python3 benchmark.py --repeats 20 --max-threads "$SLURM_CPUS_PER_TASK" --output "results/run-${SLURM_JOB_ID}"
